{
  "name": "ai-console",
  "private": true,
  "version": "1.0.0",
  "description": "AI 控制台 - 跨工具對話與派工中心",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && npm run test:py",
    "test:web": "vitest run",
    "test:py": "python -m unittest discover -s server/tests",
    "preview": "vite preview",
    "app": "electron .",
    "pack": "electron-packager . \"AI控制台\" --platform=win32 --arch=x64 --out=release --icon=build/icon.ico --overwrite --ignore=\"node_modules/(?!.*(electron|node-pty|node-addon-api))\" --ignore=\"^/src\" --ignore=\"^/public\" --ignore=\"^/archives\" --ignore=\"^/private\" --ignore=\"^/assets-src\" --ignore=\"^/release\""
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^43.4.0",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
